# Copia este archivo como .env. Nunca subas .env al repositorio.
# demo: SQLite local con datos ilustrativos. oracle: Oracle real, sin fallback.
DB_MODE=demo
# Para Oracle XE 21c: localhost:1521/XEPDB1
# Para Oracle Free 23ai/26ai: localhost:1521/FREEPDB1
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=localhost:1521/FREEPDB1
PORT=5000
